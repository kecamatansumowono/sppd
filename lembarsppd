<!-- FIREBASE SDK & APP LOGIC -->
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { 
    getFirestore, collection, getDocs, getDoc, doc, addDoc, updateDoc, deleteDoc, writeBatch 
} from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

// --- KONFIGURASI FIREBASE ---
const firebaseConfig = {
    apiKey: "AIzaSyAZu8jGmIa8sMO1TbtpivfdFcRAshH9Xus",
    authDomain: "sppd-kecamatan.firebaseapp.com",
    projectId: "sppd-kecamatan",
    storageBucket: "sppd-kecamatan.firebasestorage.app",
    messagingSenderId: "87536518263",
    appId: "1:87536518263:web:80f4d80ae3e1b43f4f3272"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);
const pejabatCol = collection(db, "pejabat");

let selectedSig = null;
let pejabatCache = [];

// --- FIRESTORE CRUD LOGIC ---
async function fetchPejabatData() {
    try {
        const snapshot = await getDocs(pejabatCol);
        pejabatCache = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        return pejabatCache;
    } catch (err) {
        console.error("Gagal mengambil data dari Firestore:", err);
        return [];
    }
}

window.savePejabat = async function(e) {
    e.preventDefault();
    const id = document.getElementById("pejabatId").value;
    const instansi = document.getElementById("inputInstansi").value;
    const title = document.getElementById("inputTitle").value;
    const name = document.getElementById("inputName").value;
    const rank = document.getElementById("inputRank").value;
    const nip = document.getElementById("inputNip").value;

    const data = { instansi, title, name, rank, nip };

    try {
        if (id) {
            await updateDoc(doc(db, "pejabat", id), data);
        } else {
            await addDoc(pejabatCol, data);
        }
        resetForm();
        await fetchPejabatData();
        renderDatabaseTable();
    } catch (err) {
        alert("Gagal menyimpan data ke Firestore: " + err.message);
    }
};

window.deletePejabatFromDB = async function(id) {
    if (confirm("Hapus data pejabat ini dari database Firestore?")) {
        try {
            await deleteDoc(doc(db, "pejabat", id));
            await fetchPejabatData();
            renderDatabaseTable();
        } catch (err) {
            alert("Gagal menghapus data: " + err.message);
        }
    }
};

window.editPejabat = function(id) {
    const data = pejabatCache.find(p => p.id === id);
    if (data) {
        document.getElementById("pejabatId").value = data.id;
        document.getElementById("inputInstansi").value = data.instansi || '';
        document.getElementById("inputTitle").value = data.title || '';
        document.getElementById("inputName").value = data.name || '';
        document.getElementById("inputRank").value = data.rank || '';
        document.getElementById("inputNip").value = data.nip || '';
        document.getElementById("btnSaveForm").textContent = "Update Pejabat";
    }
};

window.resetForm = function() {
    document.getElementById("pejabatId").value = "";
    document.getElementById("pejabatForm").reset();
    document.getElementById("btnSaveForm").textContent = "Simpan Pejabat";
};

window.renderDatabaseTable = function() {
    const keyword = document.getElementById("dbSearchInput").value.toLowerCase();
    const tbody = document.getElementById("pejabatTableBody");
    tbody.innerHTML = "";

    const filteredList = pejabatCache.filter(p => 
        (p.name && p.name.toLowerCase().includes(keyword)) ||
        (p.title && p.title.toLowerCase().includes(keyword)) ||
        (p.instansi && p.instansi.toLowerCase().includes(keyword))
    );

    if (filteredList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" style="text-align:center;">Data tidak ditemukan.</td></tr>`;
        return;
    }

    filteredList.forEach(p => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
            <td><b>${p.instansi || '-'}</b></td>
            <td>${(p.title || '').replace(/\n/g, '<br>')}</td>
            <td><b>${p.name || ''}</b><br><small>${p.rank || ''}</small><br><small>${p.nip || '-'}</small></td>
            <td>
                <div class="actions-cell">
                    <button class="btn-primary" onclick="editPejabat('${p.id}')">Edit</button>
                    <button class="btn-danger" onclick="deletePejabatFromDB('${p.id}')">Hapus</button>
                </div>
            </td>
        `;
        tbody.appendChild(tr);
    });
};

// --- BACKUP & RESTORE LOGIC ---
window.backupDatabase = function() {
    if (pejabatCache.length === 0) {
        alert("Database kosong, tidak ada data untuk di-backup.");
        return;
    }

    const exportData = pejabatCache.map(({ id, ...rest }) => rest);
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportData, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `backup_pejabat_sppd_${new Date().toISOString().slice(0,10)}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
};

window.restoreDatabase = function(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = async function(event) {
        try {
            const importedData = JSON.parse(event.target.result);
            if (!Array.isArray(importedData)) {
                throw new Error("Format JSON harus berupa array data pejabat.");
            }

            if (confirm(`Apakah Anda yakin ingin mengimpor ${importedData.length} data pejabat ke Firestore?`)) {
                const batch = writeBatch(db);
                importedData.forEach(item => {
                    const newRef = doc(pejabatCol);
                    batch.set(newRef, {
                        instansi: item.instansi || "",
                        title: item.title || "",
                        name: item.name || "",
                        rank: item.rank || "",
                        nip: item.nip || ""
                    });
                });

                await batch.commit();
                alert("Restorasi data ke Firestore berhasil!");
                await fetchPejabatData();
                renderDatabaseTable();
            }
        } catch (err) {
            alert("Gagal merestore database: " + err.message);
        }
        e.target.value = ""; 
    };
    reader.readAsText(file);
};

