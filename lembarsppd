// --- DRAG & DROP MOVABLE SIGNATURE LOGIC ---
function setupMovableAndResizable(element) {
    let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
    const resizeHandle = element.querySelector('.resize-handle');
    const baseWidth = 260; 
    const baseFontSize = 13; 

    element.onmousedown = function(e) {
        if (e.target.isContentEditable || e.target === resizeHandle) return;
        e.preventDefault();
        selectSignature(element);

        pos3 = e.clientX;
        pos4 = e.clientY;

        document.onmouseup = closeDragElement;
        document.onmousemove = elementDrag;
    };

    function elementDrag(e) {
        e.preventDefault();
        pos1 = pos3 - e.clientX;
        pos2 = pos4 - e.clientY;
        pos3 = e.clientX;
        pos4 = e.clientY;

        element.style.top = (element.offsetTop - pos2) + "px";
        element.style.left = (element.offsetLeft - pos1) + "px";
    }

    function closeDragElement() {
        document.onmouseup = null;
        document.onmousemove = null;
    }

    if (resizeHandle) {
        resizeHandle.onmousedown = function(e) {
            e.preventDefault();
            e.stopPropagation();
            selectSignature(element);

            let startWidth = element.offsetWidth;
            let startX = e.clientX;

            function doResize(e) {
                let newWidth = startWidth + (e.clientX - startX);
                if (newWidth > 120 && newWidth < 600) {
                    element.style.width = newWidth + 'px';
                    let scale = newWidth / baseWidth;
                    element.style.fontSize = (baseFontSize * scale) + 'px';
                }
            }

            function stopResize() {
                document.removeEventListener('mousemove', doResize);
                document.removeEventListener('mouseup', stopResize);
            }

            document.addEventListener('mousemove', doResize);
            document.addEventListener('mouseup', stopResize);
        };
    }
}

function selectSignature(element) {
    document.querySelectorAll('.movable-signature').forEach(el => el.classList.remove('selected'));
    if (element) {
        element.classList.add('selected');
        selectedSig = element;
    } else {
        selectedSig = null;
    }
}

function addMovableSignature(data) {
    const paper = document.getElementById('paper');
    const newSig = document.createElement('div');
    newSig.className = 'movable-signature';
    newSig.style.top = '100mm';
    newSig.style.left = '20mm';

    let titleText = "";
    if (data) {
        titleText = `${data.title}<br>${data.instansi}`;
    } else {
        titleText = "Jabatan Pejabat<br>Nama Instansi";
    }

    const titleHTML = titleText.replace(/\n/g, '<br>');
    const nameHTML = data ? data.name : "NAMA PEJABAT, S.H.";
    const rankHTML = data ? (data.rank || "") : "Pangkat / Golongan";
    const nipHTML = data ? (data.nip || "") : "NIP. 00000000 000000 0 000";

    newSig.innerHTML = `
        <div class="sig-title editable-field" contenteditable="true">${titleHTML}</div>
        <div class="sig-name editable-field" contenteditable="true">${nameHTML}</div>
        <div class="sig-rank editable-field" contenteditable="true">${rankHTML}</div>
        <div class="sig-nip editable-field" contenteditable="true">${nipHTML}</div>
        <div class="resize-handle"></div>
    `;
    paper.appendChild(newSig);
    setupMovableAndResizable(newSig);
    selectSignature(newSig);
}

window.deleteSelectedSignature = function() {
    if (selectedSig) {
        selectedSig.remove();
        selectedSig = null;
    } else {
        alert("Pilih tanda tangan yang ingin dihapus dengan mengkliknya terlebih dahulu.");
    }
};

window.clearFields = function() {
    if (confirm("Bersihkan seluruh isian yang dapat diedit?")) {
        document.querySelectorAll('.sppd [contenteditable="true"]').forEach(el => {
            if (el.textContent.trim() !== "Kecamatan Sumowono") el.textContent = "";
        });
    }
};

window.printContentOnly = function() {
    document.body.classList.add('print-content-only');
    window.print();
};

window.addEventListener('afterprint', () => {
    document.body.classList.remove('print-content-only');
});

document.getElementById('paper').addEventListener('click', function(e) {
    if (!e.target.closest('.movable-signature')) {
        selectSignature(null);
    }
});

// Load awal
fetchPejabatData();
